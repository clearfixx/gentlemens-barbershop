# Copy to .env.local for development. Do not commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gentlemens_barbershop
PAYLOAD_SECRET=replace-with-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password recovery delivery uses Resend (same provider as guest cancellation).
# Configure a verified sending domain and keep the key server-side.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
