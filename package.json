{
  "name": "gentlemens-barbershop",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
